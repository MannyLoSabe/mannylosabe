    function switchTab(mode) {
      const panels = { explore: 'panelExplore', lever: 'panelLever', quiz: 'panelQuiz' };
      const btns = { explore: 'btnModeExplore', lever: 'btnModeLever', quiz: 'btnModeQuiz' };
      const activeColor = { explore: 'bg-cyan-600', lever: 'bg-amber-600', quiz: 'bg-emerald-600' };
      const base = "px-3 py-1.5 text-xs font-semibold rounded-md transition flex items-center gap-1.5 ";

      Object.keys(panels).forEach(k => {
        const p = document.getElementById(panels[k]);
        const b = document.getElementById(btns[k]);
        if (k === mode) {
          p.classList.remove('hidden'); p.classList.add('flex');
          b.className = base + activeColor[k] + " text-white";
        } else {
          p.classList.add('hidden'); p.classList.remove('flex');
          b.className = base + "bg-slate-800 text-slate-300 hover:bg-slate-700";
        }
      });

      if (mode === 'lever') calculateLeverRule();
    }

    // ==========================================
    // REGOLA DELLA LEVA
    // ==========================================
    function calculateLeverRule() {
      const C0 = parseFloat(document.getElementById('inputC0').value) || 0;
      const Ca = parseFloat(document.getElementById('inputCalpha').value) || 0;
      const Cb = parseFloat(document.getElementById('inputCbeta').value) || 0;

      if (Cb <= Ca || C0 < Ca || C0 > Cb) {
        document.getElementById('resPhase1').innerText = "Input non valido";
        document.getElementById('resPhase2').innerText = "Input non valido";
        return;
      }

      const W_alpha = ((Cb - C0) / (Cb - Ca)) * 100;
      const W_beta = 100 - W_alpha;

      document.getElementById('resPhase1').innerText = W_alpha.toFixed(1) + " %";
      document.getElementById('resPhase2').innerText = W_beta.toFixed(1) + " %";
    }

    // ==========================================
    // QUIZ
    // ==========================================
    function initQuiz() {
      currentQuizIdx = 0;
      quizScoreCount = 0;
      showQuestion(currentQuizIdx);
    }

    function showQuestion(idx) {
      if (idx >= quizQuestions.length) {
        document.getElementById('quizQuestionTitle').innerText = "Quiz Completato!";
        document.getElementById('quizOptions').innerHTML = `
          <div class="p-4 bg-slate-950 rounded-lg text-center">
            <p class="text-sm font-bold text-emerald-400 mb-1">Punteggio Finale: ${quizScoreCount} / ${quizQuestions.length}</p>
            <p class="text-xs text-slate-400">Ottimo lavoro nell'esplorazione del Diagramma Ferro-Carbonio!</p>
          </div>
        `;
        document.getElementById('btnNextQuiz').innerText = "Ricomincia Quiz";
        document.getElementById('btnNextQuiz').onclick = () => { initQuiz(); };
        document.getElementById('quizFeedback').classList.add('hidden');
        return;
      }

      const q = quizQuestions[idx];
      document.getElementById('quizQuestionTitle').innerText = `${idx + 1}. ${q.q}`;
      document.getElementById('quizScore').innerText = `Score: ${quizScoreCount} / ${quizQuestions.length}`;
      document.getElementById('quizFeedback').classList.add('hidden');

      const optionsContainer = document.getElementById('quizOptions');
      optionsContainer.innerHTML = '';

      q.options.forEach((opt, optIdx) => {
        const btn = document.createElement('button');
        btn.className = "w-full text-left p-3 text-xs font-semibold rounded-lg bg-slate-950 border border-slate-800 hover:border-cyan-500 hover:bg-slate-800 transition text-slate-200";
        btn.innerText = opt;
        btn.onclick = () => checkAnswer(optIdx, q.correct, q.exp);
        optionsContainer.appendChild(btn);
      });

      document.getElementById('btnNextQuiz').innerText = "Prossima Domanda";
      document.getElementById('btnNextQuiz').onclick = () => loadNextQuestion();
    }

    function checkAnswer(selected, correct, explanation) {
      const feedback = document.getElementById('quizFeedback');
      feedback.classList.remove('hidden');

      const buttons = document.getElementById('quizOptions').querySelectorAll('button');
      buttons.forEach(b => b.disabled = true);

      if (selected === correct) {
        quizScoreCount++;
        feedback.className = "p-3 rounded-lg text-xs font-semibold mb-3 bg-emerald-500/20 border border-emerald-500/40 text-emerald-300";
        feedback.innerHTML = `<i class="fa-solid fa-circle-check"></i> <strong>Corretto!</strong> ${explanation}`;
        buttons[selected].className = "w-full text-left p-3 text-xs font-semibold rounded-lg bg-emerald-950 border border-emerald-500 text-emerald-200";
      } else {
        feedback.className = "p-3 rounded-lg text-xs font-semibold mb-3 bg-rose-500/20 border border-rose-500/40 text-rose-300";
        feedback.innerHTML = `<i class="fa-solid fa-circle-xmark"></i> <strong>Sbagliato.</strong> ${explanation}`;
        buttons[selected].className = "w-full text-left p-3 text-xs font-semibold rounded-lg bg-rose-950 border border-rose-500 text-rose-200";
        buttons[correct].className = "w-full text-left p-3 text-xs font-semibold rounded-lg bg-emerald-950/60 border border-emerald-500/60 text-emerald-300";
      }

      document.getElementById('quizScore').innerText = `Score: ${quizScoreCount} / ${quizQuestions.length}`;
    }

    function loadNextQuestion() {
      currentQuizIdx++;
      showQuestion(currentQuizIdx);
    }
  </script>
</body>
