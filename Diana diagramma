        const btn = document.getElementById(`filter-${f}`);
        if (btn) {
          btn.className = "px-3 py-1.5 rounded-md font-medium transition " +
            (f === filterType ? "text-white bg-slate-800" : "text-slate-400 hover:text-white");
        }
      });

      const points = document.querySelectorAll('.point-group');
      const zones = document.querySelectorAll('.zone-shape');
      const steelBg = document.getElementById('steelRegionBg');
      const ironBg = document.getElementById('ironRegionBg');

      if (filterType === 'all') {
        points.forEach(p => p.style.opacity = '1');
        zones.forEach(z => z.style.opacity = '1');
        steelBg.style.opacity = '0.3'; ironBg.style.opacity = '0.3';
      } else if (filterType === 'points') {
        points.forEach(p => p.style.opacity = '1');
        zones.forEach(z => z.style.opacity = '0.2');
        steelBg.style.opacity = '0.05'; ironBg.style.opacity = '0.05';
      } else if (filterType === 'phases') {
        points.forEach(p => p.style.opacity = '0.25');
        zones.forEach(z => z.style.opacity = '1');
        steelBg.style.opacity = '0.1'; ironBg.style.opacity = '0.1';
      } else if (filterType === 'steels') {
        points.forEach(p => p.style.opacity = '0.6');
        zones.forEach(z => z.style.opacity = '0.4');
        steelBg.style.opacity = '0.7'; ironBg.style.opacity = '0.7';
      }
    }

