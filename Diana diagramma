    function selectRegion(id) {
      if (!feCData[id]) return;
      clearHighlights();
      selectedElementId = id;
      const el = document.getElementById(`zone-${id}`);
      if (el) el.classList.add('selected');
      updateDetailPanel(feCData[id]);
    }

    function selectPoint(id) {
      if (!feCData[id]) return;
      clearHighlights();
      selectedElementId = id;
      const pt = document.getElementById(`pt-${id}`);
      if (pt) pt.classList.add('selected');
      updateDetailPanel(feCData[id]);
    }

    function clearHighlights() {
      document.querySelectorAll('.zone-shape').forEach(z => z.classList.remove('selected'));
      document.querySelectorAll('.point-marker').forEach(p => p.classList.remove('selected'));
