<!DOCTYPE html>
<html lang="it" class="h-full bg-slate-900">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Diagramma di Stato Ferro-Carbonio Interattivo (Fe-Fe3C)</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

  <script>
    tailwind.config = {
      theme: { extend: { fontFamily: { sans: ['Inter', 'sans-serif'] } } }
    }
  </script>

  <style>
    .zone-shape { transition: all 0.25s ease; cursor: pointer; stroke-width: 1.5; stroke-linejoin: round; }
    .zone-shape:hover { filter: brightness(1.3) drop-shadow(0px 0px 8px rgba(0, 180, 216, 0.6)); stroke-width: 2.5; }
    .zone-shape.selected { filter: brightness(1.4) drop-shadow(0px 0px 12px rgba(255, 159, 28, 0.9)); stroke: #ff9f1c !important; stroke-width: 3; }
    /* Regioni molto piccole: bordo spesso per facilitare il click */
    .zone-shape.zone-tiny { stroke-width: 5; }
    .zone-shape.zone-tiny:hover { stroke-width: 6; }

    .point-marker { cursor: pointer; transition: r 0.2s ease; }
    .point-marker:hover { r: 8; filter: drop-shadow(0 0 6px #ffffff); }
    .point-marker.selected { r: 9; stroke: #ff9f1c; stroke-width: 3; filter: drop-shadow(0 0 10px #ff9f1c); }

    @keyframes pulse-ring {
      0% { transform: scale(0.95); opacity: 0.8; }
      50% { transform: scale(1.3); opacity: 0.3; }
      100% { transform: scale(0.95); opacity: 0.8; }
    }
    /* transform-box: fill-box fa scalare l'anello attorno al proprio centro (non all'origine dell'SVG) */
    .pulse-node { animation: pulse-ring 2s infinite ease-in-out; transform-box: fill-box; transform-origin: center; }

    .region-label { cursor: pointer; }

    ::-webkit-scrollbar { width: 6px; height: 6px; }
    ::-webkit-scrollbar-track { background: #0f172a; }
    ::-webkit-scrollbar-thumb { background: #334155; border-radius: 4px; }
    ::-webkit-scrollbar-thumb:hover { background: #475569; }
  </style>
</head>
<body class="h-full text-slate-200 flex flex-col font-sans antialiased bg-slate-950">

  <header class="bg-slate-900 border-b border-slate-800 sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      <div class="flex items-center space-x-3">
        <div class="p-2 bg-cyan-500/10 border border-cyan-500/30 rounded-lg text-cyan-400">
          <i class="fa-solid fa-atom text-xl"></i>
        </div>
        <div>
          <h1 class="font-bold text-lg text-white leading-tight">Diagramma Ferro-Carbonio</h1>
          <p class="text-xs text-slate-400">Simulatore ed Esploratore Metallurgico Interattivo</p>
        </div>
      </div>

      <div class="flex items-center space-x-2">
        <button id="btnModeExplore" onclick="switchTab('explore')" class="px-3 py-1.5 text-xs font-semibold rounded-md bg-cyan-600 text-white transition hover:bg-cyan-500 flex items-center gap-1.5">
          <i class="fa-solid fa-compass"></i> Esploratore
        </button>
        <button id="btnModeLever" onclick="switchTab('lever')" class="px-3 py-1.5 text-xs font-semibold rounded-md bg-slate-800 text-slate-300 hover:bg-slate-700 transition flex items-center gap-1.5">
          <i class="fa-solid fa-calculator"></i> Calcolatore Leva
        </button>
        <button id="btnModeQuiz" onclick="switchTab('quiz')" class="px-3 py-1.5 text-xs font-semibold rounded-md bg-slate-800 text-slate-300 hover:bg-slate-700 transition flex items-center gap-1.5">
          <i class="fa-solid fa-graduation-cap"></i> Quiz
        </button>
      </div>
    </div>
  </header>

  <main class="flex-1 max-w-7xl w-full mx-auto p-4 sm:p-6 grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">

    <div class="lg:col-span-7 xl:col-span-8 flex flex-col gap-4">

      <div class="bg-slate-900 border border-slate-800 rounded-xl p-3 flex flex-wrap items-center justify-between gap-3">
        <div class="flex items-center space-x-1 bg-slate-950 p-1 rounded-lg border border-slate-800 text-xs">
          <button onclick="setFilter('all')" id="filter-all" class="px-3 py-1.5 rounded-md font-medium text-white bg-slate-800 transition">Tutti</button>
          <button onclick="setFilter('points')" id="filter-points" class="px-3 py-1.5 rounded-md font-medium text-slate-400 hover:text-white transition">Punti Critici</button>
          <button onclick="setFilter('phases')" id="filter-phases" class="px-3 py-1.5 rounded-md font-medium text-slate-400 hover:text-white transition">Fasi / Regioni</button>
          <button onclick="setFilter('steels')" id="filter-steels" class="px-3 py-1.5 rounded-md font-medium text-slate-400 hover:text-white transition">Acciai vs Ghise</button>
        </div>

        <div class="flex items-center space-x-2 text-xs">
          <button onclick="resetDiagramSelection()" class="px-2.5 py-1.5 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-lg border border-slate-700 transition flex items-center gap-1">
            <i class="fa-solid fa-rotate-left"></i> Reset
          </button>
        </div>
      </div>

      <div class="bg-slate-900 border border-slate-800 rounded-xl p-4 shadow-xl relative overflow-hidden flex flex-col items-center">
        <div class="w-full flex justify-between items-center text-xs font-semibold px-2 mb-2 text-slate-400">
          <span class="text-cyan-400"><i class="fa-solid fa-info-circle"></i> Clicca su una zona o punto notevole per analizzare</span>
          <span class="bg-slate-800 px-2 py-1 rounded text-slate-300 border border-slate-700">Fe-Fe₃C Metastabile</span>
        </div>

        <!--
          SCALE DEL GRAFICO (coerenti per tutti gli elementi):
          x(C%) = 70 + 90 * C        -> 0% = 70 ; 6.67% = 670
          y(T°C) = 40 + (1600 - T) * 0.35  -> 1600°C = 40 ; 400°C = 460
        -->
        <div class="w-full relative" style="aspect-ratio: 750 / 520;">
          <svg id="feCPhaseDiagram" viewBox="0 0 750 520" class="w-full h-full select-none">
            <defs>
              <linearGradient id="gradLiquid" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#f59e0b" stop-opacity="0.5"/>
                <stop offset="100%" stop-color="#ef4444" stop-opacity="0.4"/>
              </linearGradient>
              <linearGradient id="gradAustenite" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#0284c7" stop-opacity="0.45"/>
                <stop offset="100%" stop-color="#3b82f6" stop-opacity="0.35"/>
              </linearGradient>
              <linearGradient id="gradFerrite" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#10b981" stop-opacity="0.6"/>
                <stop offset="100%" stop-color="#059669" stop-opacity="0.5"/>
              </linearGradient>
              <linearGradient id="gradSteels" x1="0%" y1="0%" x2="100%" y2="0%">
                <stop offset="0%" stop-color="#38bdf8" stop-opacity="0.15"/>
                <stop offset="100%" stop-color="#818cf8" stop-opacity="0.15"/>
              </linearGradient>
              <linearGradient id="gradCastIrons" x1="0%" y1="0%" x2="100%" y2="0%">
                <stop offset="0%" stop-color="#f43f5e" stop-opacity="0.15"/>
                <stop offset="100%" stop-color="#fb7185" stop-opacity="0.15"/>
              </linearGradient>
            </defs>

            <!-- Sfondo Acciai (0 - 2.14% C) e Ghise (2.14 - 6.67% C) -->
            <rect id="steelRegionBg" x="70" y="40" width="192.6" height="420" fill="url(#gradSteels)" opacity="0.3" class="transition-opacity duration-300"/>
            <rect id="ironRegionBg" x="262.6" y="40" width="407.4" height="420" fill="url(#gradCastIrons)" opacity="0.3" class="transition-opacity duration-300"/>

            <!-- Isoterme di riferimento -->
            <g stroke="#334155" stroke-dasharray="3,3" stroke-width="1">
              <line x1="70" y1="61.7"  x2="670" y2="61.7"/>   <!-- 1538 -->
              <line x1="70" y1="76.8"  x2="670" y2="76.8"/>   <!-- 1495 -->
              <line x1="70" y1="112.1" x2="670" y2="112.1"/>  <!-- 1394 -->
              <line x1="70" y1="198.5" x2="670" y2="198.5"/>  <!-- 1147 -->
              <line x1="70" y1="280.8" x2="670" y2="280.8"/>  <!-- 912 -->
            </g>
            <line x1="70" y1="345.5" x2="670" y2="345.5" stroke="#f59e0b" stroke-dasharray="4,4" stroke-width="1.5"/> <!-- 727 A1 -->
            <line x1="70" y1="330.5" x2="122.5" y2="330.5" stroke="#ef4444" stroke-dasharray="4,3" stroke-width="1.8"/> <!-- 770 Curie A2 (solo fino alla linea A3) -->

            <!-- Verticali di composizione -->
            <line x1="72"    y1="40" x2="72"    y2="460" stroke="#334155" stroke-dasharray="2,2"/>
            <line x1="138.4" y1="40" x2="138.4" y2="460" stroke="#00b4d8" stroke-dasharray="3,3" stroke-width="1.5"/>
            <line x1="262.6" y1="40" x2="262.6" y2="460" stroke="#ff9f1c" stroke-dasharray="4,4" stroke-width="2"/>
            <line x1="457"   y1="40" x2="457"   y2="460" stroke="#f43f5e" stroke-dasharray="3,3" stroke-width="1.5"/>
            <line x1="670"   y1="40" x2="670"   y2="460" stroke="#475569" stroke-width="2"/>

            <!-- REGIONI (poligoni calcolati dalle coordinate reali del diagramma) -->
            <!-- Liquido: A-B-C-D e bordo superiore -->
            <polygon id="zone-liquid" data-id="liquid" points="70,40 670,40 670,170.5 457,198.5 117.7,76.8 70,61.7"
                     fill="url(#gradLiquid)" stroke="#f59e0b" class="zone-shape"/>

            <!-- L + γ : B-J-E-C -->
            <polygon id="zone-l_gamma" data-id="l_gamma" points="117.7,76.8 85.3,76.8 262.6,198.5 457,198.5"
                     fill="#ea580c" fill-opacity="0.25" stroke="#f97316" class="zone-shape"/>

            <!-- L + Fe3C : C-D-F -->
            <polygon id="zone-l_fe3c" data-id="l_fe3c" points="457,198.5 670,170.5 670,198.5"
                     fill="#dc2626" fill-opacity="0.25" stroke="#ef4444" class="zone-shape"/>

            <!-- Austenite γ : N-J-E-S-G -->
            <polygon id="zone-austenite" data-id="austenite" points="70,112.1 85.3,76.8 262.6,198.5 138.4,345.5 70,280.8"
                     fill="url(#gradAustenite)" stroke="#0284c7" class="zone-shape"/>

            <!-- γ + Fe3C : E-F-K-S -->
            <polygon id="zone-gamma_fe3c" data-id="gamma_fe3c" points="262.6,198.5 670,198.5 670,345.5 138.4,345.5"
                     fill="#8b5cf6" fill-opacity="0.2" stroke="#a855f7" class="zone-shape"/>

            <!-- α + γ : G-S-P -->
            <polygon id="zone-alpha_gamma" data-id="alpha_gamma" points="70,280.8 138.4,345.5 72,345.5"
                     fill="#14b8a6" fill-opacity="0.3" stroke="#2dd4bf" class="zone-shape"/>

            <!-- α + Fe3C (campo acciai) -->
            <polygon id="zone-alpha_fe3c" data-id="alpha_fe3c" points="72,345.5 262.6,345.5 262.6,460 70.7,460"
                     fill="#64748b" fill-opacity="0.3" stroke="#94a3b8" class="zone-shape"/>

            <!-- Campo ghise a temperatura ambiente -->
            <polygon id="zone-castiron_ambient" data-id="castiron_ambient" points="262.6,345.5 670,345.5 670,460 262.6,460"
                     fill="#475569" fill-opacity="0.4" stroke="#64748b" class="zone-shape"/>

            <!-- Regioni piccole (disegnate per ultime, sopra le altre) -->
            <!-- Ferrite α : G-P-Q -->
            <polygon id="zone-ferrite_alpha" data-id="ferrite_alpha" points="70,280.8 72,345.5 70.7,460 70,460"
                     fill="url(#gradFerrite)" stroke="#10b981" class="zone-shape zone-tiny"/>
            <!-- δ : A-H-N -->
            <polygon id="zone-ferrite_delta" data-id="ferrite_delta" points="70,61.7 78.1,76.8 70,112.1"
                     fill="#38bdf8" fill-opacity="0.5" stroke="#0284c7" class="zone-shape zone-tiny"/>
            <!-- δ + γ : N-H-J -->
            <polygon id="zone-delta_gamma" data-id="delta_gamma" points="70,112.1 78.1,76.8 85.3,76.8"
                     fill="#22d3ee" fill-opacity="0.4" stroke="#06b6d4" class="zone-shape zone-tiny"/>
            <!-- δ + L : A-B-H -->
            <polygon id="zone-delta_liquid" data-id="delta_liquid" points="70,61.7 117.7,76.8 78.1,76.8"
                     fill="#f59e0b" fill-opacity="0.4" stroke="#fbbf24" class="zone-shape zone-tiny"/>

            <!-- Etichette asse Y (temperatura) -->
            <g font-size="10" fill="#94a3b8" text-anchor="end" font-weight="600">
              <text x="62" y="65">1538°C</text>
              <text x="62" y="80">1495°C</text>
              <text x="62" y="115">1394°C</text>
              <text x="62" y="202" fill="#ff9f1c">1147°C</text>
              <text x="62" y="284">912°C</text>
              <text x="62" y="334" fill="#ef4444">770°C</text>
              <text x="62" y="349" fill="#f59e0b">727°C</text>
              <text x="62" y="463">400°C</text>
            </g>

            <!-- Etichette asse X (carbonio) -->
            <g font-size="10" fill="#94a3b8" text-anchor="middle" font-weight="600">
              <text x="64"    y="478">0</text>
              <text x="80"    y="492" fill="#10b981">0.022</text>
              <text x="138.4" y="478" fill="#00b4d8">0.76</text>
              <text x="262.6" y="478" fill="#ff9f1c">2.14</text>
              <text x="457"   y="478" fill="#f43f5e">4.30</text>
              <text x="670"   y="478">6.67</text>
            </g>

            <text x="370" y="512" font-size="12" font-weight="700" fill="#cbd5e1" text-anchor="middle">Tenore di Carbonio (% in peso C)</text>
            <text x="14" y="250" font-size="12" font-weight="700" fill="#cbd5e1" text-anchor="middle" transform="rotate(-90 14 250)">Temperatura (°C)</text>

            <!-- Etichette di regione -->
            <g font-size="11" font-weight="700" pointer-events="none" text-anchor="middle">
              <text x="400" y="110" fill="#fef08a">LIQUIDO (L)</text>
              <text x="140" y="245" fill="#bae6fd">AUSTENITE (γ)</text>
              <text x="268" y="165" fill="#fed7aa" font-size="10">L + γ</text>
              <text x="598" y="193" fill="#fca5a5" font-size="9">L + Fe₃C</text>
              <text x="470" y="280" fill="#ddd6fe">γ + Fe₃C</text>
              <text x="100" y="339" fill="#99f6e4" font-size="8">α + γ</text>
              <text x="170" y="410" fill="#cbd5e1">Acciai (α + Fe₃C)</text>
              <text x="466" y="410" fill="#94a3b8">Ghise (α + Fe₃C)</text>
              <text x="170" y="424" fill="#94a3b8" font-size="9" font-weight="500">Perlite + Ferrite / Cementite</text>
              <text x="466" y="424" fill="#94a3b8" font-size="9" font-weight="500">Ledeburite trasformata + Perlite</text>
            </g>
            <!-- Etichetta cliccabile per la ferrite α (regione molto stretta) -->
            <g class="region-label" onclick="selectRegion('ferrite_alpha')">
              <text x="82" y="395" font-size="12" font-weight="800" fill="#34d399">α</text>
              <line x1="80" y1="391" x2="71.5" y2="380" stroke="#34d399" stroke-width="1"/>
            </g>

            <!-- PUNTI NOTEVOLI -->
            <!-- A: fusione Fe puro -->
            <g class="point-group" onclick="selectPoint('pointA')">
              <circle cx="70" cy="61.7" r="5" fill="#ef4444" id="pt-pointA" class="point-marker"/>
              <text x="80" y="58" font-size="11" font-weight="800" fill="#ffffff" pointer-events="none">A</text>
            </g>
            <!-- N: δ ⇌ γ -->
            <g class="point-group" onclick="selectPoint('pointN')">
              <circle cx="70" cy="112.1" r="5" fill="#38bdf8" id="pt-pointN" class="point-marker"/>
              <text x="80" y="124" font-size="11" font-weight="800" fill="#ffffff" pointer-events="none">N</text>
            </g>
            <!-- G: γ ⇌ α -->
            <g class="point-group" onclick="selectPoint('pointG')">
              <circle cx="70" cy="280.8" r="5" fill="#10b981" id="pt-pointG" class="point-marker"/>
              <text x="80" y="284" font-size="11" font-weight="800" fill="#ffffff" pointer-events="none">G</text>
            </g>
            <!-- M: Curie -->
            <g class="point-group" onclick="selectPoint('pointM')">
              <circle cx="70" cy="330.5" r="4.5" fill="#ef4444" id="pt-pointM" class="point-marker"/>
              <text x="80" y="324" font-size="10" font-weight="800" fill="#ef4444" pointer-events="none">M (Curie A₂)</text>
            </g>
            <!-- J: peritettico (0.17% C, 1495°C) -->
            <g class="point-group" onclick="selectPoint('pointJ')">
              <circle cx="85.3" cy="76.8" r="5.5" fill="#f59e0b" id="pt-pointJ" class="point-marker"/>
              <text x="96" y="95" font-size="11" font-weight="800" fill="#fbbf24" pointer-events="none">J (Peritettico)</text>
            </g>
            <!-- E: 2.14% C, 1147°C -->
            <g class="point-group" onclick="selectPoint('pointE')">
              <circle cx="262.6" cy="198.5" r="6" fill="#ff9f1c" id="pt-pointE" class="point-marker"/>
              <text x="262.6" y="188" font-size="11" font-weight="800" fill="#ff9f1c" text-anchor="middle" pointer-events="none">E (2.14% C)</text>
            </g>
            <!-- C: eutettico -->
            <g class="point-group" onclick="selectPoint('pointC')">
              <circle cx="457" cy="198.5" r="7" fill="#f43f5e" id="pt-pointC" class="point-marker"/>
              <circle cx="457" cy="198.5" r="11" fill="none" stroke="#f43f5e" stroke-width="1.5" class="pulse-node" pointer-events="none"/>
              <text x="457" y="182" font-size="12" font-weight="800" fill="#f43f5e" text-anchor="middle" pointer-events="none">C (Eutettico)</text>
            </g>
            <!-- S: eutettoidico (0.76% C, 727°C) -->
            <g class="point-group" onclick="selectPoint('pointP')">
              <circle cx="138.4" cy="345.5" r="7" fill="#00b4d8" id="pt-pointP" class="point-marker"/>
              <circle cx="138.4" cy="345.5" r="11" fill="none" stroke="#00b4d8" stroke-width="1.5" class="pulse-node" pointer-events="none"/>
              <text x="138.4" y="368" font-size="12" font-weight="800" fill="#38bdf8" text-anchor="middle" pointer-events="none">S (Eutettoidico)</text>
            </g>
          </svg>
        </div>

        <div class="w-full mt-3 pt-3 border-t border-slate-800 flex flex-wrap justify-between items-center text-xs gap-2">
          <div class="flex items-center space-x-4">
            <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-full bg-cyan-500 inline-block"></span> Austenite (γ)</span>
            <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-full bg-emerald-500 inline-block"></span> Ferrite (α/δ)</span>
            <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-full bg-amber-500 inline-block"></span> Liquido (L)</span>
            <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-full bg-purple-500 inline-block"></span> Cementite (Fe₃C)</span>
          </div>
          <div class="text-slate-400 italic">
            <i class="fa-solid fa-arrows-left-right"></i> Acciai: 0 - 2.14% C | Ghise: &gt; 2.14% C
          </div>
        </div>
      </div>
    </div>

    <div class="lg:col-span-5 xl:col-span-4 flex flex-col gap-4">

      <!-- ESPLORATORE -->
      <div id="panelExplore" class="bg-slate-900 border border-slate-800 rounded-xl p-5 shadow-xl flex flex-col justify-between min-h-[520px]">
        <div>
          <div class="flex items-center justify-between mb-3">
            <span id="detailBadge" class="px-2.5 py-1 text-xs font-bold rounded-md uppercase tracking-wider bg-cyan-500/20 text-cyan-400 border border-cyan-500/30">
              Seleziona un elemento
            </span>
            <span id="detailCategory" class="text-xs text-slate-400 font-medium">Fase / Punto</span>
          </div>

          <h2 id="detailTitle" class="text-2xl font-extrabold text-white mb-2 leading-snug">Diagramma Ferro-Carbonio</h2>

          <p id="detailSubtitle" class="text-sm text-slate-400 mb-4 leading-relaxed">
            Clicca su qualunque area colorata o punto notevole sul diagramma per esplorare la descrizione chimico-fisica, le trasformazioni ed i reticoli cristallini.
          </p>

          <hr class="border-slate-800 my-4">

          <div id="detailProperties" class="grid grid-cols-2 gap-3 mb-4">
            <div class="bg-slate-950 p-3 rounded-lg border border-slate-800">
              <span class="text-[10px] uppercase font-bold text-slate-500 block">Temperatura</span>
              <span id="propTemp" class="text-sm font-semibold text-slate-200">-- °C</span>
            </div>
            <div class="bg-slate-950 p-3 rounded-lg border border-slate-800">
              <span class="text-[10px] uppercase font-bold text-slate-500 block">Carbonio (% wt)</span>
              <span id="propCarbon" class="text-sm font-semibold text-slate-200">-- % C</span>
            </div>
            <div class="bg-slate-950 p-3 rounded-lg border border-slate-800">
              <span class="text-[10px] uppercase font-bold text-slate-500 block">Reticolo / Trasformazione</span>
              <span id="propLattice" class="text-sm font-semibold text-cyan-400">--</span>
            </div>
            <div class="bg-slate-950 p-3 rounded-lg border border-slate-800">
              <span class="text-[10px] uppercase font-bold text-slate-500 block">Reazione / Tipo</span>
              <span id="propReaction" class="text-sm font-semibold text-amber-400">--</span>
            </div>
          </div>

          <div id="detailExtendedBox" class="bg-slate-950/60 p-4 rounded-xl border border-slate-800/80">
            <h4 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-2 flex items-center gap-1.5">
              <i class="fa-solid fa-microscope text-cyan-400"></i> Microstruttura &amp; Proprietà Meccaniche
            </h4>
