    function updateDetailPanel(data) {
      document.getElementById('detailTitle').innerText = data.title;
      document.getElementById('detailCategory').innerText = data.category;
      document.getElementById('propTemp').innerText = data.temp || '--';
      document.getElementById('propCarbon').innerText = data.carbon || '--';
      document.getElementById('propLattice').innerText = data.lattice || '--';
      document.getElementById('propReaction').innerText = data.reaction || '--';
      document.getElementById('detailExtendedText').innerHTML = data.description;

      const badge = document.getElementById('detailBadge');
      badge.className = `px-2.5 py-1 text-xs font-bold rounded-md uppercase tracking-wider border ${data.badgeColor || 'bg-cyan-500/20 text-cyan-400 border-cyan-500/30'}`;
